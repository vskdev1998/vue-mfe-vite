# SHELL_B · every variable the app understands. Override locally in .env.[mode].local
VITE_APP_NAME=shell-b                       # sent as X-Client-App header
VITE_APP_TITLE=Shell B · Tasks             # standalone <title>
VITE_APP_ENV=development                  # development | localprod | staging | production
VITE_PORT=5002                           # dev + preview port
VITE_PUBLIC_URL=http://localhost:5002/   # where this remote is served (build base / dev origin)
VITE_API_BASE_URL=https://jsonplaceholder.typicode.com
VITE_API_TIMEOUT=8000                     # axios timeout (ms) for THIS remote's instance only
VITE_HOST_URL=http://localhost:5000/      # where the host lives
VITE_USE_MOCK_API=false                   # true = skip the API, use src/services/fixtures
