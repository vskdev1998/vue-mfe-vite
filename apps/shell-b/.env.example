# SHELL_B · every variable this app understands (documentation only).
# Override on your machine in .env.[mode].local (git-ignored).
VITE_APP_NAME=shell-b                       # X-Client-App header, logs
VITE_APP_TITLE=Shell B · Tasks
VITE_APP_ENV=development                  # development | localprod | staging | production
VITE_PORT=5002                           # dev + preview port
VITE_DEV_HOST=localhost                   # server.host (0.0.0.0 to expose on LAN)
VITE_PUBLIC_URL=http://localhost:5002/   # dev server.origin + build base
VITE_OPEN=false                           # open browser on dev start
VITE_SOURCEMAP=true                       # build.sourcemap
VITE_DROP_CONSOLE=false                   # strip console.log/debug + debugger in builds
VITE_CORS_ORIGINS=http://localhost:5000  # who may load this remote
VITE_HOST_URL=http://localhost:5000/
VITE_HOST_ENTRY=http://localhost:5000/remoteEntry.js   # where host/ui-dev comes from
VITE_API_BASE_URL=https://jsonplaceholder.typicode.com
VITE_API_TIMEOUT=8000                     # this remote's axios timeout (ms)
VITE_USE_MOCK_API=false                   # true = skip the API, use fixtures
