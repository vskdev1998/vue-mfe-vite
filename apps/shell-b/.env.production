# SHELL_B · production  (npm run build  (vite build → mode=production))
VITE_APP_ENV=production

# ---- server / build (used by vite.config.mjs) ----
# Public URL of this app: dev server.origin + build `base`
VITE_PUBLIC_URL=https://shell-b.example.com/
VITE_OPEN=false
VITE_SOURCEMAP=false
# Host headers accepted by dev/preview server (comma list, ".x.com" = subdomains, true = any)
VITE_ALLOWED_HOSTS=.example.com
# Custom build entry (HTML file relative to the app root) and output layout
VITE_BUILD_ENTRY=index.html
VITE_OUT_DIR=dist
VITE_ASSETS_DIR=assets
VITE_DROP_CONSOLE=true
# Origins allowed to load this remote (comma separated)
VITE_CORS_ORIGINS=https://app.example.com

# ---- host (provides the shared ui-dev library) ----
VITE_HOST_URL=https://app.example.com/
VITE_HOST_ENTRY=https://app.example.com/remoteEntry.js

# ---- runtime (browser) ----
VITE_API_BASE_URL=https://jsonplaceholder.typicode.com
# true = always use offline fixtures (src/services/fixtures)
VITE_USE_MOCK_API=false
