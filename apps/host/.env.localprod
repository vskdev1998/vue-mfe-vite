# HOST · localprod  (npm run build:localprod + preview)
# A production build that still points at localhost, so you can test the
# real federated bundles on your machine (ports 5000/5001/5002 via vite preview).
VITE_APP_ENV=localprod
VITE_PUBLIC_URL=http://localhost:5000/
VITE_API_BASE_URL=https://dummyjson.com
VITE_SHELL_A_ENTRY=http://localhost:5001/remoteEntry.js
VITE_SHELL_B_ENTRY=http://localhost:5002/remoteEntry.js
VITE_USE_MOCK_AUTH=true
