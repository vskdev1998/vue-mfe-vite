# =====================================================================
# HOST · .env  (loaded in EVERY mode, lowest priority)
# Load order (later wins): .env < .env.local < .env.[mode] < .env.[mode].local < shell env
# vite.config.mjs reads ALL keys through config/env.mjs (loadEnv(mode, root, '')).
# Only VITE_* keys are exposed to browser code as import.meta.env.VITE_*.
# =====================================================================
VITE_APP_NAME=host
VITE_APP_TITLE=Vue MFE Host
VITE_PORT=5000
VITE_DEV_HOST=localhost
VITE_API_TIMEOUT=10000
