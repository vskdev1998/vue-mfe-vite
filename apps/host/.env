# =====================================================================
# HOST · .env  (loaded in EVERY mode, lowest priority)
# Load order (later wins): .env < .env.local < .env.[mode] < .env.[mode].local
# Only VITE_* vars reach client code (import.meta.env). vite.config.js can read
# all of them through loadEnv(mode, cwd, '').
# =====================================================================
VITE_APP_NAME=host
VITE_APP_TITLE=Vue MFE Host
VITE_PORT=5000
VITE_API_TIMEOUT=10000
