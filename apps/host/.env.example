# HOST · every variable this app understands (documentation only).
# Override on your machine in .env.[mode].local (git-ignored).
VITE_APP_NAME=host                       # X-Client-App header, logs
VITE_APP_TITLE=Vue MFE Host
VITE_APP_ENV=development                  # development | localprod | staging | production
VITE_PORT=8080                           # dev + preview port
VITE_DEV_HOST=localhost                   # server.host (0.0.0.0 to expose on LAN)
VITE_PUBLIC_URL=http://localhost:8080/   # dev server.origin + build base
VITE_OPEN=false                           # open browser on dev start
VITE_SOURCEMAP=true                       # build.sourcemap
VITE_ALLOWED_HOSTS=localhost,127.0.0.1,.localhost   # server/preview.allowedHosts (true = any host)
VITE_BUILD_ENTRY=index.html                # build.rollupOptions.input.main
VITE_OUT_DIR=dist                          # build.outDir
VITE_ASSETS_DIR=assets                     # build.assetsDir + output file name prefix
VITE_DROP_CONSOLE=false                   # strip console.log/debug + debugger in builds
VITE_CORS_ORIGINS=http://localhost:8081,http://localhost:8082  # who may load host/ui-dev
VITE_SHELL_A_ENTRY=http://localhost:8081/remoteEntry.js
VITE_SHELL_B_ENTRY=http://localhost:8082/remoteEntry.js
VITE_API_BASE_URL=https://dummyjson.com
VITE_API_TIMEOUT=10000                    # host axios timeout (ms)
VITE_USE_MOCK_AUTH=true
VITE_API_GATEWAY_HEADER=x-api-gateway-key  # header name the gateway reads
VITE_API_GATEWAY_KEY=gw_host_dev_xxxxxxxxxxxxxxxx   # per app AND per environment, sent on every request
VITE_MOCK_GATEWAY_KEY=gw_host_dev_xxxxxxxxxxxxxxxx  # what the mock API accepts (must match the key above)
