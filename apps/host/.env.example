# HOST · every variable the app understands. Copy to .env.[mode].local to override
# values on your machine without committing them (*.local is git-ignored).
VITE_APP_NAME=host                     # identifier sent as X-Client-App header
VITE_APP_TITLE=Vue MFE Host            # <title> (used in index.html as %VITE_APP_TITLE%)
VITE_APP_ENV=development               # development | localprod | staging | production
VITE_PORT=5000                         # dev + preview port
VITE_PUBLIC_URL=http://localhost:5000/ # public URL of the host (remotes link back to it; CORS allow-list)
VITE_API_BASE_URL=https://dummyjson.com
VITE_API_TIMEOUT=10000                 # axios timeout (ms) for the HOST instance only
VITE_SHELL_A_ENTRY=http://localhost:5001/remoteEntry.js
VITE_SHELL_B_ENTRY=http://localhost:5002/remoteEntry.js
VITE_USE_MOCK_AUTH=true
