# HOST · development  (npm run dev  (vite → mode=development))
VITE_APP_ENV=development

# ---- server / build (used by vite.config.mjs) ----
# Public URL of this app: dev server.origin + build `base`
VITE_PUBLIC_URL=http://localhost:5000/
VITE_OPEN=false
VITE_SOURCEMAP=true
VITE_DROP_CONSOLE=false
# Origins allowed to load host/ui-dev (comma separated)
VITE_CORS_ORIGINS=http://localhost:5001,http://localhost:5002

# ---- remotes consumed by the host ----
VITE_SHELL_A_ENTRY=http://localhost:5001/remoteEntry.js
VITE_SHELL_B_ENTRY=http://localhost:5002/remoteEntry.js

# ---- runtime (browser) ----
VITE_API_BASE_URL=https://dummyjson.com
# true = mock login demo/demo123 · false = POST {VITE_API_BASE_URL}/auth/login
VITE_USE_MOCK_AUTH=true
