# HOST · development  (npm run dev  (vite → mode=development))
VITE_APP_ENV=development

# ---- server / build (used by vite.config.mjs) ----
# Public URL of this app: dev server.origin + build `base`
VITE_PUBLIC_URL=http://localhost:8080/
VITE_OPEN=false
VITE_SOURCEMAP=true
# Host headers accepted by dev/preview server (comma list, ".x.com" = subdomains, true = any)
VITE_ALLOWED_HOSTS=localhost,127.0.0.1,.localhost
# Custom build entry (HTML file relative to the app root) and output layout
VITE_BUILD_ENTRY=index.html
VITE_OUT_DIR=dist
VITE_ASSETS_DIR=assets
VITE_DROP_CONSOLE=false
# Origins allowed to load host/ui-dev (comma separated)
VITE_CORS_ORIGINS=http://localhost:8081,http://localhost:8082

# ---- remotes consumed by the host ----
VITE_SHELL_A_ENTRY=http://localhost:8081/remoteEntry.js
VITE_SHELL_B_ENTRY=http://localhost:8082/remoteEntry.js

# ---- runtime (browser) ----
VITE_API_BASE_URL=https://dummyjson.com
# true = mock login demo/demo123 · false = POST {VITE_API_BASE_URL}/auth/login
VITE_USE_MOCK_AUTH=true
