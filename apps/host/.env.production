# HOST · production  (npm run build  (vite build → mode=production))
VITE_APP_ENV=production

# ---- server / build (used by vite.config.mjs) ----
# Public URL of this app: dev server.origin + build `base`
VITE_PUBLIC_URL=https://app.example.com/
VITE_OPEN=false
VITE_SOURCEMAP=false
VITE_DROP_CONSOLE=true
# Origins allowed to load host/ui-dev (comma separated)
VITE_CORS_ORIGINS=https://shell-a.example.com,https://shell-b.example.com

# ---- remotes consumed by the host ----
VITE_SHELL_A_ENTRY=https://shell-a.example.com/remoteEntry.js
VITE_SHELL_B_ENTRY=https://shell-b.example.com/remoteEntry.js

# ---- runtime (browser) ----
VITE_API_BASE_URL=https://api.example.com
# true = mock login demo/demo123 · false = POST {VITE_API_BASE_URL}/auth/login
VITE_USE_MOCK_AUTH=false
