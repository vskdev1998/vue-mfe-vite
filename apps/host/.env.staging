# HOST · staging  (npm run build:staging  (vite build --mode staging))
VITE_APP_ENV=staging

# ---- server / build (used by vite.config.mjs) ----
# Public URL of this app: dev server.origin + build `base`
VITE_PUBLIC_URL=https://staging.example.com/
VITE_OPEN=false
VITE_SOURCEMAP=true
# Host headers accepted by dev/preview server (comma list, ".x.com" = subdomains, true = any)
VITE_ALLOWED_HOSTS=.staging.example.com
# Custom build entry (HTML file relative to the app root) and output layout
VITE_BUILD_ENTRY=index.html
VITE_OUT_DIR=dist
VITE_ASSETS_DIR=assets
VITE_DROP_CONSOLE=false
# Origins allowed to load host/ui-dev (comma separated)
VITE_CORS_ORIGINS=https://shell-a.staging.example.com,https://shell-b.staging.example.com

# ---- remotes consumed by the host ----
VITE_SHELL_A_ENTRY=https://shell-a.staging.example.com/remoteEntry.js
VITE_SHELL_B_ENTRY=https://shell-b.staging.example.com/remoteEntry.js

# ---- runtime (browser) ----
VITE_API_BASE_URL=https://api.staging.example.com
# true = mock login demo/demo123 · false = POST {VITE_API_BASE_URL}/auth/login
VITE_USE_MOCK_AUTH=false
