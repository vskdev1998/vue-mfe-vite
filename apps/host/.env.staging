# HOST · staging  (npm run build:staging  →  vite build --mode staging)
# Replace example.com with your real staging domains / CDN paths.
VITE_APP_ENV=staging
VITE_PUBLIC_URL=https://staging.example.com/
VITE_API_BASE_URL=https://api.staging.example.com
VITE_SHELL_A_ENTRY=https://shell-a.staging.example.com/remoteEntry.js
VITE_SHELL_B_ENTRY=https://shell-b.staging.example.com/remoteEntry.js
VITE_USE_MOCK_AUTH=false
