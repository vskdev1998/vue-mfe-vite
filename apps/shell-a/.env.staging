# SHELL_A · staging  (npm run build:staging  (vite build --mode staging))
VITE_APP_ENV=staging

# ---- server / build (used by vite.config.mjs) ----
# Public URL of this app: dev server.origin + build `base`
VITE_PUBLIC_URL=https://shell-a.staging.example.com/
VITE_OPEN=false
VITE_SOURCEMAP=true
VITE_DROP_CONSOLE=false
# Origins allowed to load this remote (comma separated)
VITE_CORS_ORIGINS=https://staging.example.com

# ---- host (provides the shared ui-dev library) ----
VITE_HOST_URL=https://staging.example.com/
VITE_HOST_ENTRY=https://staging.example.com/remoteEntry.js

# ---- runtime (browser) ----
VITE_API_BASE_URL=https://dummyjson.com
# true = always use offline fixtures (src/services/fixtures)
VITE_USE_MOCK_API=false
