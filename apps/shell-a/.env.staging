# SHELL_A · staging  (npm run build:staging  (vite build --mode staging))
VITE_APP_ENV=staging

# ---- server / build (used by vite.config.mjs) ----
# Public URL of this app: dev server.origin + build `base`
VITE_PUBLIC_URL=https://shell-a.staging.example.com/
VITE_OPEN=false
VITE_SOURCEMAP=true
# Host headers accepted by dev/preview server (comma list, ".x.com" = subdomains, true = any)
VITE_ALLOWED_HOSTS=.staging.example.com
# Custom build entry (HTML file relative to the app root) and output layout
VITE_BUILD_ENTRY=index.html
VITE_OUT_DIR=dist
VITE_ASSETS_DIR=assets
VITE_DROP_CONSOLE=false
# Origins allowed to load this remote (comma separated)
VITE_CORS_ORIGINS=https://staging.example.com

# ---- host (provides the shared ui-dev library) ----
VITE_HOST_URL=https://staging.example.com/
VITE_HOST_ENTRY=https://staging.example.com/remoteEntry.js

# ---- API gateway (sent by THIS app's axios instance on every request) ----
# Each app has its own key per environment. It identifies the calling app to the
# gateway; it is NOT a secret (every VITE_* value ends up in the browser bundle).
VITE_API_GATEWAY_HEADER=x-api-gateway-key
VITE_API_GATEWAY_KEY=gw_shella_stg_8be91dceaada4bae
# Key the built-in MOCK API expects. Must equal VITE_API_GATEWAY_KEY or every
# mock request is rejected with 401 (try it: change one character).
VITE_MOCK_GATEWAY_KEY=gw_shella_stg_8be91dceaada4bae

# ---- runtime (browser) ----
VITE_API_BASE_URL=https://dummyjson.com
# true = always use offline fixtures (src/services/fixtures)
VITE_USE_MOCK_API=false
