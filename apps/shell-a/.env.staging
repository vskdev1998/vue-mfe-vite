# SHELL_A · staging  (npm run build:staging)
# VITE_PUBLIC_URL becomes Vite's `base`: every chunk that remoteEntry.js imports
# is requested from here. It MUST be the URL this remote is deployed to.
VITE_APP_ENV=staging
VITE_PUBLIC_URL=https://shell-a.staging.example.com/
VITE_API_BASE_URL=https://dummyjson.com
VITE_HOST_URL=https://staging.example.com/
# true = always use offline fixtures (src/services/fixtures)
VITE_USE_MOCK_API=false
