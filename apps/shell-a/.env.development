# SHELL_A · development  (npm run dev)
VITE_APP_ENV=development
# Dev server origin. vite.config.js sets server.origin from this so assets
# load from :5001 even when the page is the host on :5000.
VITE_PUBLIC_URL=http://localhost:5001/
VITE_API_BASE_URL=https://dummyjson.com
# Host origin (used for the link back to the host in standalone mode + CORS docs)
VITE_HOST_URL=http://localhost:5000/
# true = always use offline fixtures (src/services/fixtures)
VITE_USE_MOCK_API=false
